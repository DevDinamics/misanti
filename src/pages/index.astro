---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Locations from '../components/Locations.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Services from '../components/Services.astro';

// Componentes interactivos con React + Framer Motion
import AnimatedPromoForm from '../components/AnimatedPromoForm';
import VogueShowcase from '../components/VogueShowcase';

const WHATSAPP_NUMBER = "525500000000"; // Reemplazar con el número real
const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/TU_SCRIPT_ID/exec"; // Reemplazar con URL de Apps Script
---

<Layout title="Missanti Events | Experiencias y Cabina Vogue">
  <Navbar />

  <main class="max-w-4xl mx-auto px-5 py-6">
    <Hero />

		<Services />

    <!-- Formulario React interactivo con confetti y estado reactivo -->
    <AnimatedPromoForm 
      client:load 
      whatsappNumber={WHATSAPP_NUMBER} 
      scriptUrl={GOOGLE_SCRIPT_URL} 
    />

    <!-- Showcase interactivo 3D con Framer Motion (se hidrata cuando el usuario hace scroll hacia él) -->
    <VogueShowcase client:visible />



    <Locations />
    <Footer whatsappNumber={WHATSAPP_NUMBER} />
  </main>

  <WhatsAppFloat whatsappNumber={WHATSAPP_NUMBER} />
</Layout>