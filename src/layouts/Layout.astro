---
// src/layouts/Layout.astro
import '../styles/global.css'; // Verifica tu ruta de CSS

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Missanti Events | The Vogue Experience",
  description = "La experiencia de Cabina Vogue más exclusiva de México para Bodas y XV Años.",
  image = "/og-cover.jpg",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Fuentes Apple/Haute: Cormorant Garamond / Playfair + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#fbfbfd] text-[#1d1d1f] font-['Inter',sans-serif] antialiased selection:bg-[#dfba73] selection:text-black min-h-screen flex flex-col relative overflow-x-hidden">
    
    <!-- Cintillo: Barra Apple Announcement -->
    <aside 
      aria-label="Aviso Expo"
      class="bg-[#f5f5f7]/90 border-b border-black/[0.05] text-[#6e6e73] py-2.5 px-4 text-center font-normal text-[11px] tracking-wide sticky top-0 z-50 backdrop-blur-xl">
      <div class="flex items-center justify-center gap-2">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#b8860b]"></span>
        <span>Invitación privada • <strong>Expo 15 México</strong> en Palacio de los Deportes</span>
        <a href="#apartar" class="text-[#b8860b] hover:underline font-medium ml-1">Bloquear fecha &rarr;</a>
      </div>
    </aside>

    <!-- Resplandor sutil color champagne Apple (cálido, suave) -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-amber-200/20 via-rose-100/10 to-transparent pointer-events-none -z-10 blur-[140px]"></div>

    <div class="flex-grow">
      <slot />
    </div>
  </body>
</html>