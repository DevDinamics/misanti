---
// src/components/Navbar.astro
---

<header class="w-full border-b border-black/[0.06] bg-white/75 backdrop-blur-xl sticky top-[37px] z-40 transition-all">
  <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
    
    <!-- Logo Monograma Apple Luxury -->
    <a href="/" class="group flex flex-col select-none">
      <span class="font-['Playfair_Display'] text-xl tracking-[0.25em] font-normal text-[#1d1d1f] uppercase group-hover:text-[#b8860b] transition-colors">
        Missanti
      </span>
      <span class="text-[7.5px] tracking-[0.45em] text-[#86868b] uppercase -mt-0.5">
        Atelier & Events
      </span>
    </a>

    <!-- Botón Minimalista -->
    <a 
      href="#apartar" 
      class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.18em] px-5 py-2 rounded-full bg-[#1d1d1f] text-white hover:bg-[#2d2d30] hover:shadow-md transition-all duration-300 font-medium active:scale-95">
      <span>Apartar Fecha</span>
    </a>

  </div>
</header>