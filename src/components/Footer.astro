---
// src/components/Footer.astro
interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = "5215500000000" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-black/[0.06] bg-white/70 backdrop-blur-xl mt-24 pt-16 pb-12 transition-all">
  <div class="max-w-6xl mx-auto px-5 sm:px-6">
    
    <!-- Bloque Superior: Marca, Lema y Enlaces de Redes -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-black/[0.06]">
      
      <!-- Identidad y Propuesta -->
      <div class="md:col-span-6 space-y-3">
        <a href="/" class="inline-block group select-none">
          <span class="font-['Playfair_Display'] text-2xl sm:text-3xl tracking-[0.2em] font-normal text-[#1d1d1f] uppercase group-hover:text-[#b8860b] transition-colors">
            Missanti.Events
          </span>
          <span class="block text-[8.5px] font-mono tracking-[0.45em] text-[#86868b] uppercase mt-0.5">
            Experiencias Únicas para Eventos
          </span>
        </a>

        <p class="font-['Playfair_Display'] italic text-sm text-[#b8860b] tracking-wider">
          "¿Y por qué no?"
        </p>

        <p class="text-xs text-[#6e6e73] font-light max-w-md leading-relaxed">
          Diseño escenográfico, fotografía profesional y montajes de pasarela que transforman cada celebración en un suceso extraordinario. Especialistas en XV años, bodas y eventos de gala.
        </p>
      </div>

      <!-- Directorio de Experiencias -->
      <div class="md:col-span-3 space-y-2.5">
        <span class="text-[9.5px] uppercase tracking-[0.25em] font-semibold text-[#1d1d1f] block">
          Experiencias
        </span>
        <ul class="text-xs text-[#6e6e73] space-y-2 font-light">
          <li><a href="#servicios" class="hover:text-[#b8860b] transition-colors">Cabina Vogue Monumental</a></li>
          <li><a href="#servicios" class="hover:text-[#b8860b] transition-colors">Cabina Espejada Inmersiva</a></li>
          <li><a href="#servicios" class="hover:text-[#b8860b] transition-colors">missanti.store (Boutique)</a></li>
          <li><a href="#servicios" class="hover:text-[#b8860b] transition-colors">Impresiones 4×6 Profesionales</a></li>
          <li><a href="#servicios" class="hover:text-[#b8860b] transition-colors">Decoración Floral & Ambientación</a></li>
        </ul>
      </div>

      <!-- Canales Oficiales y Concierge (Diseño geométrico limpio) -->
      <div class="md:col-span-3 space-y-3">
        <span class="text-[9.5px] uppercase tracking-[0.25em] font-semibold text-[#1d1d1f] block">
          Contacto Directo
        </span>
        
        <div class="flex flex-col gap-2">
          <a 
            href={`https://wa.me/${whatsappNumber}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-black/[0.08] bg-[#fbfbfd] hover:bg-[#1d1d1f] text-[#1d1d1f] hover:text-white text-[11px] font-medium tracking-wider transition-all duration-300 flex items-center justify-between group shadow-sm">
            <span>WhatsApp Concierge</span>
            <span class="text-[#b8860b] group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>

          <a 
            href="https://www.tiktok.com/@missanti.events" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-black/[0.08] bg-[#fbfbfd] hover:border-[#b8860b] text-[#1d1d1f] hover:text-[#b8860b] text-[11px] font-medium tracking-wider transition-all duration-300 flex items-center justify-between shadow-sm">
            <span>TikTok Oficial</span>
            <span class="text-[9px] font-mono text-[#86868b]">+900K</span>
          </a>

          <a 
            href="https://www.instagram.com/missanti.events" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-black/[0.08] bg-[#fbfbfd] hover:border-[#b8860b] text-[#1d1d1f] hover:text-[#b8860b] text-[11px] font-medium tracking-wider transition-all duration-300 flex items-center justify-between shadow-sm">
            <span>Instagram</span>
            <span class="text-[9px] font-mono text-[#86868b]">@missanti.events</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bloque Inferior: Cobertura, Términos de Reservación y Créditos -->
    <div class="pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-[11px] text-[#86868b] font-light">
      
      <!-- Sello Oficial Expo 15 -->
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#b8860b]"></span>
        <span>Expositor Oficial • <strong>Expo 15 México</strong> (Palacio de los Deportes)</span>
      </div>

      <!-- Cobertura y Reserva -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>CDMX • Estado de México • Toda la República</span>
        <span>•</span>
        <span>Reserva con 20% y Contrato Digital</span>
        <span>•</span>
        <span>© {currentYear} Missanti.Events</span>
      </div>

    </div>

  </div>
</footer>