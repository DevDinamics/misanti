---
// src/components/Services.astro
import { Image } from 'astro:assets';

// ==========================================
// 1. IMPORTACIONES MULTIMEDIA (src/assets/images/)
// ==========================================
import cabinaCompleta from '../assets/images/Cabina_V_.JPG';
import cabinaV1 from '../assets/images/Cabina_V_1.JPG';
import cabina2 from '../assets/images/cabina__2.JPG';

// Videos reales de eventos
import videoPov from '../assets/images/QUE SE LE NTOJA A LA REYNA_.mp4';
import videoDron from '../assets/images/Dron.mp4';
import videoVertical2 from '../assets/images/POV XV SONIDO .mp4';

// ==========================================
// 2. LAS 3 EXPERIENCIAS ESTRELLA MISSANTI
// ==========================================
const coreServices = [
  {
    id: "cabina-vogue",
    tier: "EXPERIENCIA INSIGNIA",
    title: "Cabina Vogue",
    subtitle: "La portada de revista monumental interactiva donde los invitados se convierten en protagonistas de pasarela.",
    duration: "4 Horas de Servicio Continuo",
    highlight: true,
    badge: "MÁS SOLICITADO EN EXPO 15",
    features: [
      "Fotografías digitales ILIMITADAS en alta resolución durante todo el evento",
      "Álbum digital instantáneo en la nube para compartir vía código QR en vivo",
      "Diseño y tipografía de carátula 100% personalizada a juego con la temática y vestido",
      "Back de tocador Hollywood con espejo e iluminación perimetral continua",
      "Alfombra roja de gala y postes unifila dorados para delimitar el acceso VIP",
      "Utilería editorial elegante seleccionada (props chic, gafas retro, accesorios)",
      "Iluminación fotográfica profesional de estudio (alta fidelidad CRI 95+)",
      "Asistente técnico dedicado durante todo el servicio + Montaje y desmontaje incluidos",
      "Posibilidad de complementar con impresiones fotográficas profesionales al instante"
    ],
    buttonText: "Cotizar Cabina Vogue"
  },
  {
    id: "cabina-espejada",
    tier: "INMERSIÓN & REFLEJOS",
    title: "Cabina Espejada",
    subtitle: "Estructura futurista de superficies reflejantes que genera efectos visuales infinitos y contenido viral de alto impacto.",
    duration: "Contratación Individual o en Combo",
    highlight: false,
    badge: "TENDENCIA 2026",
    features: [
      "Estructura 100% espejada que produce reflejos y efectos de perspectiva únicos",
      "Letrero de neón decorativo exclusivo de diseño",
      "Esferas decorativas (orbs) para ambientación escénica y estética visual",
      "Iluminación ambiental envolvente calibrada para video de TikTok y Reels",
      "Espacio ideal para sesiones de foto y video de la quinceañera, novios e invitados",
      "Montaje y desmontaje profesional adaptado a salón o jardín",
      "Disponible en paquete combinado 'missanti.premium' junto a Cabina Vogue"
    ],
    buttonText: "Cotizar Cabina Espejada"
  },
  {
    id: "missanti-store",
    tier: "CONCEPTO BOUTIQUE",
    title: "missanti.store",
    subtitle: "Transformamos la tradicional entrega de recuerdos en una tienda de lujo dentro del salón, con ceremonia inaugural.",
    duration: "Formatos: 3, 7 y 9 Módulos",
    highlight: false,
    badge: "CONCEPTO INNOVADOR",
    features: [
      "Ceremonia de inauguración con listón, moño y tijeras gigantes de gala",
      "Módulo principal personalizado con foto de alta resolución de la festejada",
      "Módulos de exhibición escalonados para regalos pequeños, medianos y grandes",
      "Estructura circular de exhibición de tres niveles con iluminación propia",
      "Iluminación LED integrada en las repisas + iluminación exterior profesional",
      "Arco de entrada decorativo y letrero luminoso missanti.store",
      "Alfombra roja y postes unifila dorados para mantener el orden",
      "Personal de apoyo dedicado durante el servicio + Montaje y desmontaje"
    ],
    buttonText: "Cotizar missanti.store"
  }
];

// ==========================================
// 3. IMPRESIONES FOTOGRÁFICAS PROFESIONALES
// ==========================================
const printPackages = [
  {
    qty: "100 Impresiones",
    price: "$3,500 MXN",
    desc: "Ideal para recepciones íntimas y familiares de hasta 100 invitados.",
    popular: false
  },
  {
    qty: "150 Impresiones",
    price: "$5,250 MXN",
    desc: "La cantidad más recomendada para eventos promedio de 150 a 200 personas.",
    popular: true
  },
  {
    qty: "200 Impresiones",
    price: "$7,000 MXN",
    desc: "Cobertura amplia para grandes fiestas de gala asegurando recuerdo a cada familia.",
    popular: false
  }
];

// ==========================================
// 4. EXPERIENCIAS COMBINADAS POPULARES
// ==========================================
const comboPackages = [
  {
    title: "Vogue + Impresiones",
    tag: "COMBO RECUERDO",
    desc: "La experiencia completa de Cabina Vogue sumando el paquete de impresiones térmicas que elijas."
  },
  {
    title: "missanti.premium",
    tag: "DOBLE CABINA VIP",
    desc: "Cabina Vogue monumental + Cabina Espejada inmersiva para un circuito de fotos sin filas."
  },
  {
    title: "Vogue + missanti.store",
    tag: "CONCEPTO TOTAL",
    desc: "Sesión fotográfica editorial combinada con la boutique personalizada para la entrega de recuerdos."
  },
  {
    title: "The All-Inclusive Experience",
    tag: "MÁXIMA GALA",
    desc: "Cabina Vogue + Impresiones profesionales + missanti.store con ceremonia de corte de listón."
  }
];

// ==========================================
// 5. OTROS SERVICIOS DECORATIVOS
// ==========================================
const extraServices = [
  "Decoración floral de alta gama",
  "Arreglos decorativos personalizados",
  "Centros de mesa exclusivos",
  "Arcos y estructuras arquitectónicas",
  "Entelados y ambientación de salones",
  "Montajes temáticos a medida"
];

// ==========================================
// 6. GALERÍA MULTIMEDIA ASIMÉTRICA BENTO
// ==========================================
const galleryItems = [
  {
    type: "video" as const,
    src: videoPov,
    title: "POV: Cabina Vogue en vivo",
    badge: "Reel Viral",
    colSpan: "col-span-1 lg:row-span-2"
  },
  {
    type: "image" as const,
    src: cabinaCompleta,
    title: "Montaje Completo en Jardín",
    subtitle: "Cabina monumental, tocador Hollywood y unifilas doradas",
    badge: "Setup VIP",
    colSpan: "col-span-1 sm:col-span-2 lg:col-span-2"
  },
  {
    type: "image" as const,
    src: cabinaV1,
    title: "Portada & Tipografía a Medida",
    subtitle: "Diseño gráfico adaptado a tu evento",
    badge: "Detalle Exclusivo",
    colSpan: "col-span-1"
  },
  {
    type: "image" as const,
    src: cabina2,
    title: "Estructura & Flores de Pasarela",
    subtitle: "Iluminación perimetral continua de estudio",
    badge: "Alta Costura",
    colSpan: "col-span-1"
  },
  {
    type: "video" as const,
    src: videoDron,
    title: "Escenografía Aérea & Producción",
    subtitle: "Cobertura cinematográfica y ambiente de gala",
    badge: "Toma con Dron",
    colSpan: "col-span-1 sm:col-span-2 lg:col-span-2"
  },
  {
    type: "video" as const,
    src: videoVertical2,
    title: "Experiencia Quinceañera",
    badge: "Mis XV • En Vivo",
    colSpan: "col-span-1"
  }
];

// ==========================================
// 7. PROCESO DE RESERVACIÓN EN 6 PASOS
// ==========================================
const bookingSteps = [
  { num: "01", title: "Selección de Servicio", desc: "Elige tu Cabina Vogue, Cabina Espejada, missanti.store o combo." },
  { num: "02", title: "Confirmación de Fecha", desc: "Validamos de inmediato la agenda para tu salón, jardín o hacienda." },
  { num: "03", title: "Cotización Expo 15", desc: "Recibes tu presupuesto formal con tarifa preferencial de evento." },
  { num: "04", title: "Anticipo del 20%", desc: "Apartas y bloqueas tu fecha con solo el veinte por ciento." },
  { num: "05", title: "Contrato Digital", desc: "Firma electrónica de contrato con validez oficial y garantía de servicio." },
  { num: "06", title: "Confirmación Total", desc: "Coordinación técnica de logística y horarios de montaje con tu salón." }
];
---

<section id="servicios" class="my-20 sm:my-28 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
  
  <!-- Encabezado de Sección Estilo Apple / Alta Costura -->
  <div class="text-center space-y-3.5 max-w-2xl mx-auto mb-16 sm:mb-20">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.03] border border-black/[0.06] backdrop-blur-md">
      <span class="w-1.5 h-1.5 rounded-full bg-[#b8860b] animate-pulse"></span>
      <span class="text-[10px] uppercase tracking-[0.25em] text-[#86868b] font-medium">
        Catálogo Oficial • Expo 15 México
      </span>
    </div>

    <h2 class="font-['Playfair_Display'] text-3xl sm:text-5xl md:text-[3.25rem] font-normal text-[#1d1d1f] tracking-tight leading-[1.12]">
      Experiencias únicas para <br />
      <span class="italic font-normal bg-gradient-to-r from-[#b8860b] via-[#cf9b38] to-[#8a6510] bg-clip-text text-transparent">
        celebraciones extraordinarias
      </span>
    </h2>

    <p class="text-xs sm:text-sm text-[#86868b] font-light leading-relaxed max-w-xl mx-auto">
      Diseñadas para XV años, bodas, cumpleaños y eventos de alta gama en CDMX, Estado de México y toda la República.
    </p>
  </div>

  <!-- 1. LOS 3 PILARES ESTRELLA (Cabina Vogue, Cabina Espejada, missanti.store) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-6 items-stretch pt-2">
    {coreServices.map((item) => (
      <div 
        class={`group relative rounded-[2rem] p-6 sm:p-8 flex flex-col justify-between transition-all duration-500 ${
          item.highlight 
            ? "bg-gradient-to-b from-white via-[#fffdf9] to-[#faf6ed] border-2 border-[#b8860b]/45 shadow-[0_25px_60px_-15px_rgba(184,134,11,0.15)] ring-1 ring-[#b8860b]/20 lg:-translate-y-3 z-10" 
            : "bg-white/85 backdrop-blur-xl border border-black/[0.08] shadow-[0_15px_40px_-15px_rgba(0,0,0,0.04)] hover:shadow-xl hover:border-black/15"
        }`}>
        
        {/* Badge Flotante Superior */}
        {item.badge && (
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-20">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#1d1d1f] text-[#dfba73] text-[9px] uppercase tracking-[0.2em] font-medium shadow-md border border-[#dfba73]/30 whitespace-nowrap">
              <span class="w-1.5 h-1.5 rounded-full bg-[#dfba73] animate-ping"></span>
              {item.badge}
            </span>
          </div>
        )}

        {/* Resplandor decorativo de fondo */}
        {item.highlight && (
          <div class="absolute -top-20 -right-20 w-52 h-52 bg-gradient-to-b from-[#b8860b]/10 to-transparent rounded-full blur-3xl pointer-events-none" />
        )}

        <div class="space-y-6 relative z-10">
          
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[9.5px] uppercase tracking-[0.3em] font-semibold text-[#86868b]">
                {item.tier}
              </span>
              <span class={`w-1.5 h-1.5 rounded-full ${item.highlight ? 'bg-[#b8860b]' : 'bg-black/15'}`}></span>
            </div>

            <h3 class="font-['Playfair_Display'] text-2xl sm:text-[1.75rem] font-normal text-[#1d1d1f] tracking-tight leading-tight">
              {item.title}
            </h3>

            <!-- Duración / Modalidad en cápsula -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/[0.03] border border-black/[0.05] text-[#1d1d1f] text-[11px] font-medium tracking-wide">
              <span class="w-1.5 h-1.5 rounded-full bg-[#b8860b]"></span>
              <span>{item.duration}</span>
            </div>

            <p class="text-xs text-[#6e6e73] font-light leading-relaxed pt-1">
              {item.subtitle}
            </p>
          </div>

          <div class="h-px w-full bg-black/[0.06]"></div>

          <!-- Lista de características oficiales -->
          <div class="space-y-3.5">
            <p class="text-[9.5px] uppercase tracking-[0.22em] text-[#1d1d1f] font-semibold">
              ¿Qué incluye el servicio?
            </p>
            <ul class="text-xs text-[#424245] space-y-2.5 font-light">
              {item.features.map((feat) => (
                <li class="flex items-start gap-2.5 leading-snug">
                  <span class="w-4 h-4 rounded-full bg-[#b8860b]/10 text-[#b8860b] flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <!-- Botón Inferior -->
        <div class="pt-8 relative z-10 mt-6 border-t border-black/[0.05]">
          <a 
            href="#apartar" 
            class={`w-full py-3.5 px-5 rounded-full text-center text-[11px] uppercase tracking-[0.2em] font-medium transition-all duration-300 flex items-center justify-center gap-2 active:scale-95 group ${
              item.highlight 
                ? "bg-[#1d1d1f] text-white hover:bg-[#323236] shadow-md shadow-black/10" 
                : "bg-white hover:bg-[#fbfbfd] text-[#1d1d1f] border border-black/[0.1] hover:border-black/25 shadow-sm"
            }`}>
            <span>{item.buttonText}</span>
            <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

      </div>
    ))}
  </div>

  <!-- 2. SERVICIO COMPLEMENTARIO: IMPRESIONES FOTOGRÁFICAS PROFESIONALES -->
  <div class="mt-20 p-6 sm:p-10 rounded-[2rem] bg-white border border-black/[0.08] shadow-[0_20px_50px_-20px_rgba(0,0,0,0.05)] relative overflow-hidden">
    <div class="max-w-2xl mb-8 space-y-2">
      <span class="text-[9.5px] uppercase tracking-[0.3em] font-semibold text-[#b8860b]">
        RECUERDOS FÍSICOS DE COLECCIÓN
      </span>
      <h3 class="font-['Playfair_Display'] text-2xl sm:text-3xl font-normal text-[#1d1d1f]">
        Impresiones Fotográficas Profesionales
      </h3>
      <p class="text-xs sm:text-sm text-[#6e6e73] font-light leading-relaxed">
        El complemento ideal para tu Cabina Vogue. Fotografías impresas en papel térmico profesional de <strong>4 × 6 pulgadas (10 × 15 cm)</strong> con diseño personalizado a juego con la temática de tu evento y entrega inmediata durante la fiesta.
      </p>
    </div>

    <!-- Grid de los 3 paquetes con precios -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {printPackages.map((pkg) => (
        <div class={`p-6 rounded-2xl border transition-all flex flex-col justify-between ${
          pkg.popular 
            ? 'border-[#b8860b]/40 bg-[#fffdf9] shadow-sm ring-1 ring-[#b8860b]/20 sm:-translate-y-1' 
            : 'border-black/[0.06] bg-[#fbfbfd]'
        }`}>
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs uppercase tracking-wider font-semibold text-[#1d1d1f]">{pkg.qty}</span>
              {pkg.popular && (
                <span class="text-[8px] uppercase tracking-wider font-bold bg-[#b8860b] text-white px-2 py-0.5 rounded-full">Más Popular</span>
              )}
            </div>
            <div class="font-['Playfair_Display'] text-2xl sm:text-3xl font-bold text-[#1d1d1f] tracking-tight">{pkg.price}</div>
            <p class="text-[11px] text-[#86868b] font-light mt-2 leading-relaxed">{pkg.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-black/[0.05]">
            <span class="text-[9.5px] uppercase tracking-wider text-[#b8860b] font-medium">Impresión Térmica 4x6</span>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-black/[0.05] text-[11px] text-[#86868b]">
      <span>* Los paquetes de impresión son complementarios a la contratación de la Cabina Vogue.</span>
      <a href="#apartar" class="inline-flex items-center gap-1.5 text-[#1d1d1f] font-semibold uppercase tracking-wider hover:text-[#b8860b] transition-colors">
        <span>Añadir a mi cotización</span> &rarr;
      </a>
    </div>
  </div>

  <!-- 3. PAQUETES COMBINADOS (missanti.premium) -->
  <div class="mt-20 space-y-8">
    <div class="text-center space-y-2 max-w-xl mx-auto">
      <span class="text-[9.5px] uppercase tracking-[0.3em] font-semibold text-[#86868b]">
        EXPERIENCIAS MULTIPLICADAS
      </span>
      <h3 class="font-['Playfair_Display'] text-2xl sm:text-3xl font-normal text-[#1d1d1f]">
        Paquetes & Experiencias Combinadas
      </h3>
      <p class="text-xs text-[#86868b] font-light">
        Nuestros servicios pueden integrarse entre sí para una producción completa y exclusiva.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {comboPackages.map((combo) => (
        <div class="p-6 rounded-2xl bg-white border border-black/[0.07] shadow-sm flex flex-col justify-between hover:border-[#b8860b]/40 transition-colors">
          <div class="space-y-2">
            <span class="text-[8.5px] uppercase tracking-[0.25em] font-semibold text-[#b8860b] block">
              {combo.tag}
            </span>
            <h4 class="font-['Playfair_Display'] text-lg font-semibold text-[#1d1d1f] leading-snug">
              {combo.title}
            </h4>
            <p class="text-xs text-[#6e6e73] font-light leading-relaxed">
              {combo.desc}
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05]">
            <a href="#apartar" class="text-[10px] uppercase tracking-wider font-semibold text-[#1d1d1f] hover:text-[#b8860b] transition-colors flex items-center justify-between">
              <span>Personalizar combo</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 4. SECCIÓN ÁLBUM / EXPERIENCIAS EN VIVO (Bento Grid) -->
  <div class="mt-28 space-y-10">
    <div class="text-center space-y-3 max-w-xl mx-auto px-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-black/[0.03] border border-black/[0.06]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#b8860b] animate-ping"></span>
        <span class="text-[10px] uppercase tracking-[0.25em] text-[#86868b] font-medium">
          Live From Events • Galería Real
        </span>
      </div>

      <h3 class="font-['Playfair_Display'] text-3xl sm:text-4xl font-normal text-[#1d1d1f] tracking-tight">
        Así se vive en <br />
        <span class="italic font-normal bg-gradient-to-r from-[#b8860b] via-[#cf9b38] to-[#8a6510] bg-clip-text text-transparent">
          recepciones reales
        </span>
      </h3>
      <p class="text-xs text-[#86868b] font-light leading-relaxed">
        Sin simulaciones por computadora. Momentos capturados directamente en jardines, salones y haciendas con nuestros clientes.
      </p>
    </div>

    <!-- Grid Asimétrico: 3 Videos Silenciados + 3 Fotos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {galleryItems.map((item) => (
        <div class={`group relative rounded-[1.75rem] overflow-hidden bg-black/[0.02] border border-black/[0.08] shadow-[0_15px_40px_-15px_rgba(0,0,0,0.06)] hover:shadow-2xl transition-all duration-500 ${item.colSpan}`}>
          
          {item.type === "video" ? (
            <div class="relative w-full h-full min-h-[320px] sm:min-h-[360px] bg-black overflow-hidden flex items-center justify-center">
              <video 
                src={item.src} 
                autoplay 
                loop 
                muted 
                playsinline 
                webkit-playsinline
                preload="auto"
                class="gallery-video w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out">
              </video>
              
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 pointer-events-none"></div>

              <div class="absolute top-3.5 left-3.5 z-10 pointer-events-none">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md border border-white/20 text-[8.5px] uppercase tracking-widest text-white font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                  {item.badge}
                </span>
              </div>

              <div class="absolute bottom-4 left-4 right-4 z-10 text-white text-left pointer-events-none">
                <p class="font-['Playfair_Display'] text-base font-medium leading-snug drop-shadow-sm">
                  {item.title}
                </p>
                {item.subtitle ? (
                  <p class="text-[9px] text-white/80 font-light mt-0.5 drop-shadow-sm">
                    {item.subtitle}
                  </p>
                ) : (
                  <span class="text-[8.5px] uppercase tracking-widest text-[#dfba73] block mt-0.5">
                    Missanti Events • En vivo
                  </span>
                )}
              </div>
            </div>
          ) : (
            <div class="relative w-full h-full min-h-[240px] sm:min-h-[260px] overflow-hidden bg-neutral-100 flex items-center justify-center">
              <Image 
                src={item.src} 
                alt={item.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent pointer-events-none"></div>

              <div class="absolute top-3.5 left-3.5 z-10 pointer-events-none">
                <span class="px-2.5 py-1 rounded-full bg-white/85 backdrop-blur-md border border-black/[0.06] text-[8.5px] uppercase tracking-widest text-[#1d1d1f] font-medium shadow-sm">
                  {item.badge}
                </span>
              </div>

              <div class="absolute bottom-4 left-4 right-4 z-10 text-white text-left pointer-events-none">
                <p class="font-['Playfair_Display'] text-sm sm:text-base font-medium leading-snug drop-shadow-sm">
                  {item.title}
                </p>
                {item.subtitle && (
